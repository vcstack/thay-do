# Supabase — đăng nhập thật + lưu tiến trình + online + phòng Pomodoro chung.
# Copy file này thành `.env.local` rồi điền giá trị thật (KHÔNG commit .env.local).
# Lấy ở: Dashboard Supabase → Project Settings → API → Project URL + anon public key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
