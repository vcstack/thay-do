{"id": 4, "title": "你家有几口人？", "titleVi": "Nhà bạn có mấy người?", "vocab": [
{"zh": "家", "py": "jiā", "vi": "gia đình, nhà"},
{"zh": "口", "py": "kǒu", "vi": "lượng từ: người"},
{"zh": "人", "py": "rén", "vi": "người"},
{"zh": "爸爸", "py": "bàba", "vi": "bố"},
{"zh": "妈妈", "py": "māma", "vi": "mẹ"},
{"zh": "哥哥", "py": "gēge", "vi": "anh trai"},
{"zh": "姐姐", "py": "jiějie", "vi": "chị gái"},
{"zh": "弟弟", "py": "dìdi", "vi": "em trai"},
{"zh": "妹妹", "py": "mèimei", "vi": "em gái"},
{"zh": "只有", "py": "zhǐyǒu", "vi": "chỉ có"}],
"sentences": [
{"zh": "你家有几口人？", "py": "Nǐ jiā yǒu jǐ kǒu rén?", "vi": "Nhà bạn có mấy người?"},
{"zh": "我家有四口人。", "py": "Wǒ jiā yǒu sì kǒu rén.", "vi": "Nhà tôi có bốn người."},
{"zh": "我有一个哥哥。", "py": "Wǒ yǒu yí gè gēge.", "vi": "Tôi có một anh trai."},
{"zh": "我有一个妹妹。", "py": "Wǒ yǒu yí gè mèimei.", "vi": "Tôi có một em gái."},
{"zh": "我家只有三口人。", "py": "Wǒ jiā zhǐyǒu sān kǒu rén.", "vi": "Nhà tôi chỉ có ba người."}],
"dialogue": [
{"sp": "A", "zh": "你家有几口人？", "py": "Nǐ jiā yǒu jǐ kǒu rén?", "vi": "Nhà bạn có mấy người?"},
{"sp": "B", "zh": "我家有四口人。", "py": "Wǒ jiā yǒu sì kǒu rén.", "vi": "Nhà tôi có bốn người."},
{"sp": "A", "zh": "你家有哥哥或妹妹吗？", "py": "Nǐ jiā yǒu gēge huò mèimei ma?", "vi": "Nhà bạn có anh trai hoặc em gái không?"},
{"sp": "B", "zh": "我有一个哥哥，没有妹妹。", "py": "Wǒ yǒu yí gè gēge, méiyǒu mèimei.", "vi": "Tôi có một anh trai, không có em gái."},
{"sp": "A", "zh": "你爸爸妈妈做什么？", "py": "Nǐ bàba māma zuò shénme?", "vi": "Bố mẹ bạn làm gì?"},
{"sp": "B", "zh": "我爸爸是老师，我妈妈是医生。", "py": "Wǒ bàba shì lǎoshī, wǒ māma shì yīshēng.", "vi": "Bố tôi là giáo viên, mẹ tôi là bác sĩ."}]},
{"id": 5, "title": "现在几点？", "titleVi": "Bây giờ là mấy giờ?", "vocab": [
{"zh": "现在", "py": "xiànzài", "vi": "hiện tại, bây giờ"},
{"zh": "几", "py": "jǐ", "vi": "mấy, bao nhiêu"},
{"zh": "点", "py": "diǎn", "vi": "giờ (đồng hồ)"},
{"zh": "分", "py": "fēn", "vi": "phút"},
{"zh": "半", "py": "bàn", "vi": "rưỡi"},
{"zh": "刻", "py": "kè", "vi": "15 phút (một khắc)"},
{"zh": "早上", "py": "zǎoshang", "vi": "buổi sáng"},
{"zh": "下午", "py": "xiàwǔ", "vi": "buổi chiều"},
{"zh": "晚上", "py": "wǎnshang", "vi": "buổi tối"},
{"zh": "时间", "py": "shíjiān", "vi": "thời gian"}],
"sentences": [
{"zh": "现在几点？", "py": "Xiànzài jǐ diǎn?", "vi": "Bây giờ là mấy giờ?"},
{"zh": "现在八点。", "py": "Xiànzài bā diǎn.", "vi": "Bây giờ là 8 giờ."},
{"zh": "现在八点半。", "py": "Xiànzài bā diǎn bàn.", "vi": "Bây giờ là 8 giờ rưỡi."},
{"zh": "你几点去学校？", "py": "Nǐ jǐ diǎn qù xuéxiào?", "vi": "Bạn mấy giờ đi học?"},
{"zh": "我七点去学校。", "py": "Wǒ qī diǎn qù xuéxiào.", "vi": "Tôi 7 giờ đi học."}],
"dialogue": [
{"sp": "A", "zh": "现在几点？", "py": "Xiànzài jǐ diǎn?", "vi": "Bây giờ là mấy giờ?"},
{"sp": "B", "zh": "现在八点半。", "py": "Xiànzài bā diǎn bàn.", "vi": "Bây giờ là 8 giờ rưỡi."},
{"sp": "A", "zh": "你几点上课？", "py": "Nǐ jǐ diǎn shàngkè?", "vi": "Bạn mấy giờ đi học?"},
{"sp": "B", "zh": "我九点上课。", "py": "Wǒ jiǔ diǎn shàngkè.", "vi": "Tôi 9 giờ đi học."},
{"sp": "A", "zh": "下午我们几点见？", "py": "Xiàwǔ wǒmen jǐ diǎn jiàn?", "vi": "Chiều chúng ta mấy giờ gặp?"},
{"sp": "B", "zh": "下午三点见吧。", "py": "Xiàwǔ sān diǎn jiàn ba.", "vi": "Chiều 3 giờ gặp nhé."}]},
{"id": 6, "title": "你去哪儿？", "titleVi": "Bạn đi đâu?", "vocab": [
