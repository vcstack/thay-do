{"lessons": [
{"id": 1, "title": "你好！", "titleVi": "Xin chào!", "vocab": [
{"zh": "你好", "py": "nǐ hǎo", "vi": "xin chào"},
{"zh": "我", "py": "wǒ", "vi": "tôi, mình"},
{"zh": "你", "py": "nǐ", "vi": "bạn, cậu"},
{"zh": "是", "py": "shì", "vi": "là"},
{"zh": "不是", "py": "bú shì", "vi": "không phải"},
{"zh": "老师", "py": "lǎoshī", "vi": "giáo viên"},
{"zh": "学生", "py": "xuéshēng", "vi": "học sinh"},
{"zh": "中国", "py": "Zhōngguó", "vi": "Trung Quốc"},
{"zh": "人", "py": "rén", "vi": "người"},
{"zh": "名字", "py": "míngzi", "vi": "tên"}],
"sentences": [
{"zh": "你好！", "py": "Nǐ hǎo!", "vi": "Xin chào!"},
{"zh": "我是学生。", "py": "Wǒ shì xuéshēng.", "vi": "Tôi là học sinh."},
{"zh": "你是老师吗？", "py": "Nǐ shì lǎoshī ma?", "vi": "Bạn là giáo viên phải không?"},
{"zh": "我不是老师。", "py": "Wǒ bú shì lǎoshī.", "vi": "Tôi không phải là giáo viên."},
{"zh": "我叫小明。", "py": "Wǒ jiào Xiǎomíng.", "vi": "Tôi tên là Tiểu Minh."}],
"dialogue": [
{"sp": "A", "zh": "你好！", "py": "Nǐ hǎo!", "vi": "Xin chào!"},
{"sp": "B", "zh": "你好！", "py": "Nǐ hǎo!", "vi": "Xin chào!"},
{"sp": "A", "zh": "你是学生吗？", "py": "Nǐ shì xuéshēng ma?", "vi": "Bạn là học sinh phải không?"},
{"sp": "B", "zh": "是，我是学生。", "py": "Shì, wǒ shì xuéshēng.", "vi": "Đúng, tôi là học sinh."},
{"sp": "A", "zh": "你叫什么名字？", "py": "Nǐ jiào shénme míngzi?", "vi": "Bạn tên là gì?"},
{"sp": "B", "zh": "我叫小明。", "py": "Wǒ jiào Xiǎomíng.", "vi": "Tôi tên là Tiểu Minh."}]},
{"id": 2, "title": "你叫什么名字？", "titleVi": "Bạn tên là gì?", "vocab": [
