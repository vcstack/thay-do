{"zh": "叫作", "py": "jiàozuò", "vi": "gọi là"},
{"zh": "姓", "py": "xìng", "vi": "họ"},
{"zh": "先生", "py": "xiānsheng", "vi": "ông, ngài"},
{"zh": "女士", "py": "nǚshì", "vi": "bà, cô"},
{"zh": "同学", "py": "tóngxué", "vi": "bạn học, bạn cùng lớp"},
{"zh": "朋友", "py": "péngyou", "vi": "bạn bè"},
{"zh": "很高兴", "py": "hěn gāoxìng", "vi": "rất vui"}],
"sentences": [
{"zh": "你叫什么名字？", "py": "Nǐ jiào shénme míngzi?", "vi": "Bạn tên là gì?"},
{"zh": "我叫小明。", "py": "Wǒ jiào Xiǎomíng.", "vi": "Tôi tên là Tiểu Minh."},
{"zh": "我姓王，叫王明。", "py": "Wǒ xìng Wáng, jiào Wáng Míng.", "vi": "Tôi họ Vương, tên là Vương Minh."},
{"zh": "很高兴认识你。", "py": "Hěn gāoxìng rènshi nǐ.", "vi": "Rất vui được biết bạn."},
{"zh": "他叫李华。", "py": "Tā jiào Lǐ Huá.", "vi": "Anh ấy tên là Lý Hoa."}],
"dialogue": [
{"sp": "A", "zh": "你叫什么名字？", "py": "Nǐ jiào shénme míngzi?", "vi": "Bạn tên là gì?"},
{"sp": "B", "zh": "我叫小红。你呢？", "py": "Wǒ jiào Xiǎohóng. Nǐ ne?", "vi": "Tôi tên là Tiểu Hồng. Còn bạn?"},
{"sp": "A", "zh": "我姓李，叫李明。", "py": "Wǒ xìng Lǐ, jiào Lǐ Míng.", "vi": "Tôi họ Lý, tên là Lý Minh."},
{"sp": "B", "zh": "很高兴认识你！", "py": "Hěn gāoxìng rènshi nǐ!", "vi": "Rất vui được biết bạn!"},
{"sp": "A", "zh": "我也很高兴！", "py": "Wǒ yě hěn gāoxìng!", "vi": "Tôi cũng rất vui!"}]},
